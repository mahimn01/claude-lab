# Copy to .env and edit. .env is git-ignored. Do not put credentials in this file;
# Claude Code logs in on its own (see README).

# Git URL of the repository the sessions will work on (cloned into $LAB_DIR/repo).
LAB_REPO_URL=https://github.com/OWNER/REPO.git

# Where the lab lives. Defaults to the folder that contains lab-env.sh.
# LAB_DIR=/path/to/claude-lab

# Concurrent sessions allowed. Values above 4 are clamped to 4.
LAB_MAX_SESSIONS=4

# tmux sessions are named <prefix><name>. The lab only ever touches this prefix.
LAB_SESSION_PREFIX=rt-

# Branch for each workstream is <LAB_BRANCH_PREFIX><name> unless you pass one.
LAB_BRANCH_PREFIX=lab/

# Branch that worktrees are cut from, and that draft PRs target by default.
LAB_BASE_BRANCH=main

# Models. "work" sessions write code, "review" sessions read it.
LAB_MODEL_WORK=sonnet
LAB_MODEL_REVIEW=opus

# Command that starts Claude Code. Use claude-headless if you log in with a long-lived OAuth token file.
LAB_CLAUDE_CMD=claude
# LAB_TOKEN_FILE=$HOME/.config/claude-headless/token

# Test command, substituted into prompts as {{TEST_CMD}}.
LAB_TEST_CMD=run the documented test command of this project

# Space-separated tmux session names the lab must refuse to use (extra safety net).
LAB_PROTECTED_SESSIONS=

# The only identity allowed on commits made by the lab and checked by scripts/check-authorship.sh.
# Change these to your own when you fork the project.
LAB_AUTHOR_NAME=Mahimn Patel
LAB_AUTHOR_EMAIL=mahimn.patel.k@gmail.com

# Pre-accept Claude Code's folder-trust prompt for each new worktree (edits ~/.claude.json). 1 = yes, 0 = no.
LAB_PREACCEPT_TRUST=1

# Optional: use a separate tmux server (tmux -L <name>), handy for tests.
# LAB_TMUX_SOCKET=
