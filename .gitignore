# Local state, never commit
.env
*.log
__pycache__/
*.pyc
.pytest_cache/
node_modules/
installation-baseline.json

# Plugin type definitions are generated by Claude Code (`claude plugin test`), not shipped
plugin/.claude-plugin/types/

# Parallel session runner state (created under parallel/ at run time)
parallel/repo/
parallel/worktrees/
parallel/reports/
parallel/tmp/
parallel/prompts/.run-*.md
