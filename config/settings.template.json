{
  "includeCoAuthoredBy": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git stash:*)",
      "Bash(git restore:*)",
      "Bash(git rev-parse:*)",
      "Bash(git fetch:*)",
      "Bash(git rebase:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-remote:*)",
      "Bash(git worktree list:*)",
      "Bash(git blame:*)",
      "Bash(git push origin __BRANCH_PREFIX__*)",
      "Bash(git push -u origin __BRANCH_PREFIX__*)",
      "Bash(git push --set-upstream origin __BRANCH_PREFIX__*)",
      "Bash(gh pr create --draft:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run watch:*)",
      "Bash(check-authorship.sh:*)",
      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm ci:*)",
      "Bash(tmux new-session -d -s rtjob-*)",
      "Bash(tmux capture-pane:*)",
      "Bash(tmux has-session:*)",
      "Bash(tmux kill-session -t rtjob-*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(sleep:*)",
      "Bash(pwd:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(which:*)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh pr ready*)",
      "Bash(gh pr close*)",
      "Bash(gh api*)",
      "Bash(gh auth*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push*:main*)",
      "Bash(git push* main)",
      "Bash(git push* master)",
      "Bash(git push* +*)",
      "Bash(git push*--delete*)",
      "Bash(git push*--mirror*)",
      "Bash(git push*--all*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(git config*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git commit*-n *)",
      "Bash(git filter-branch*)",
      "Bash(git update-ref*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(*/.ssh/*)",
      "Bash(*.config/gh*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/claude-headless/**)",
      "Read(**/.env)"
    ],
    "additionalDirectories": [
      "__LAB_DIR__/reports"
    ]
  }
}
